PORT=3001
NODE_ENV=development


DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Per-user wallet secret encryption (AES-256-GCM)
# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
WALLET_ENCRYPTION_KEY=

# Redis configuration
#
# Managed hosts (Railway / Render / Upstash / Heroku): set REDIS_URL — a full
# connection string — on the API service AND both worker services so they all
# share the SAME Redis. On Railway, reference the Redis service:
#   REDIS_URL=${{Redis.REDIS_URL}}
# (Railway exposes REDIS_URL, not REDIS_HOST. Without this the services fall back
#  to host 'redis' and the workers never receive jobs.)
REDIS_URL=

# Local dev / docker-compose fallback (ignored when REDIS_URL is set).
# Use 'localhost' for local development, 'redis' for Docker Compose.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Worker concurrency settings
COMPILE_WORKER_CONCURRENCY=2
DEPLOY_WORKER_CONCURRENCY=2

# Worker type (for worker containers): compile | deploy
WORKER_TYPE=compile

# Email configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=WebSoroban IDE
FRONTEND_URL=https://websoroban.in

# Authentication
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# Discord OAuth (optional)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3001/api/auth/discord/callback

# Payment Configuration (plan/template purchases — verified against Horizon)
PAYMENT_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PAYMENT_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC (testnet). Optional override; defaults to the public testnet RPC.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
