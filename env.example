PORT=3001
NODE_ENV=development


DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Per-user wallet secret encryption (AES-256-GCM)
# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
WALLET_ENCRYPTION_KEY=

# Redis configuration
#
# Managed hosts (Railway / Render / Upstash / Heroku): set REDIS_URL — a full
# connection string — on the API service AND both worker services so they all
# share the SAME Redis. On Railway, reference the Redis service:
#   REDIS_URL=${{Redis.REDIS_URL}}
# (Railway exposes REDIS_URL, not REDIS_HOST. Without this the services fall back
#  to host 'redis' and the workers never receive jobs.)
REDIS_URL=

# Local dev / docker-compose fallback (ignored when REDIS_URL is set).
# Use 'localhost' for local development, 'redis' for Docker Compose.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Worker concurrency settings
COMPILE_WORKER_CONCURRENCY=2
DEPLOY_WORKER_CONCURRENCY=2

# Worker type (for worker containers): compile | deploy | test | agent | billing
WORKER_TYPE=compile

# Email configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=WebSoroban IDE
FRONTEND_URL=https://websoroban.in

# Authentication
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# Discord OAuth (optional)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3001/api/auth/discord/callback

# Payment Configuration (plan/template purchases — verified against Horizon)
PAYMENT_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PAYMENT_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC (testnet). Optional override; defaults to the public testnet RPC.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ---------------------------------------------------------------------------
# MAINNET (real funds). SDF runs NO public mainnet Soroban RPC — you MUST point
# this at a provider endpoint (e.g. a community gateway or your own node).
# Horizon mainnet defaults to SDF's public Horizon.
# ---------------------------------------------------------------------------
MAINNET_SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
MAINNET_HORIZON_URL=https://horizon.stellar.org

# ---------------------------------------------------------------------------
# AI Copilot (OpenRouter) — SERVER-SIDE ONLY. Never expose to the browser.
# OpenRouter is OpenAI-compatible: https://openrouter.ai/api/v1
# Get a key at https://openrouter.ai/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Sent as HTTP-Referer / X-Title so usage is attributed in the OpenRouter dash.
OPENROUTER_SITE_URL=https://websoroban.in
OPENROUTER_APP_NAME=WebSoroban Copilot
# Default model id when a user picks "Auto" routing (an OpenRouter model slug).
AI_DEFAULT_MODEL=openrouter/auto
# Per-run safety caps (the harness enforces these — a runaway-loop backstop).
AI_MAX_TOOL_ITERATIONS=24
AI_MAX_OUTPUT_TOKENS=8000
# Per-run output-token budget ceiling (across all model turns in a run).
AI_RUN_TOKEN_BUDGET=120000
# MAX Mode raises the reasoning effort + per-run budget.
AI_MAX_MODE_TOKEN_BUDGET=400000
# Agent worker concurrency (one slot per concurrent run / multitask sub-run).
AGENT_WORKER_CONCURRENCY=4
# Per-user BYO OpenRouter keys are encrypted at rest with WALLET_ENCRYPTION_KEY
# (same AES-256-GCM as wallet secrets) — no separate key needed.

# ---------------------------------------------------------------------------
# AI CREDITS / FIAT BILLING (Dodo Payments) — SERVER-SIDE ONLY.
# One-time credit packs bought with real money. Separate from the testnet-XLM
# plan/template flow above. See BILLING.md. Run the billing worker too:
#   npm run worker:billing        (prod)   /  worker:billing:dev (watch)
# ---------------------------------------------------------------------------
# Dodo secret API key (from the Dodo dashboard). LIVE keys charge real money.
DODO_PAYMENTS_API_KEY=
# Webhook signing secret (Standard Webhooks). Used to verify /api/webhooks/dodo.
DODO_PAYMENTS_WEBHOOK_SECRET=
# live_mode | test_mode. The SDK DEFAULTS to live_mode — set test_mode in dev!
#   test_mode dev card: 4242 4242 4242 4242, any future expiry + CVC.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Where Dodo returns the customer after checkout (defaults to FRONTEND_URL/billing).
DODO_RETURN_URL=https://websoroban.in/billing?checkout=complete
# Accept stablecoin/crypto (USDC/USDT, …) at checkout in addition to cards.
# Default on; set to false to offer card only. (Enable the crypto method in your
# Dodo dashboard too.) The credit-grant flow is identical regardless of method.
DODO_ENABLE_CRYPTO=true

# Credit-pack product ids — fill in from `npm run dodo:products` (idempotent).
# WARNING: running that script in live_mode creates REAL, purchasable products.
DODO_PRODUCT_STARTER=
DODO_PRODUCT_PRO=
DODO_PRODUCT_MAX=

# Credit economy. Credits are charged on a run's ACTUAL OpenRouter cost:
#   creditsCharged = ceil(costUsd * CREDITS_PER_USD * CREDIT_MARGIN)
# Set CREDITS_PER_USD above 1/price so it embeds margin (100 ⇒ 1 credit ≈ $0.01).
CREDITS_PER_USD=100
CREDIT_MARGIN=1
# Free credits granted once per user on signup.
SIGNUP_GRANT_CREDITS=50
# Optional pack overrides (price in USD cents, credits granted). Defaults shown.
CREDIT_PACK_STARTER_CENTS=500
CREDIT_PACK_STARTER_CREDITS=500
CREDIT_PACK_PRO_CENTS=2000
CREDIT_PACK_PRO_CREDITS=2500
CREDIT_PACK_MAX_CENTS=5000
CREDIT_PACK_MAX_CREDITS=7000
# Billing (credit-grant) worker concurrency.
BILLING_WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Admin access
# ---------------------------------------------------------------------------
# Comma-separated emails allowed to view /analytics (platform stats + user
# directory). Matched case-insensitively against the logged-in user's email.
# Leave empty to lock the analytics dashboard for everyone.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
# Structured logs are always emitted as JSON. Set LOG_LEVEL to debug|info|warn|error
# (default info). Error monitoring is opt-in: set SENTRY_DSN AND install the SDK
# (`npm i @sentry/node`) on the API + both workers to forward 5xx/uncaught errors.
LOG_LEVEL=info
SENTRY_DSN=
