{
  "name": "websoroban-backend",
  "version": "1.0.0",
  "description": "Backend API for WebSoroban IDE",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "typecheck": "tsc --noEmit",
    "worker:compile": "node dist/workers/compileWorker.js",
    "worker:deploy": "node dist/workers/deployWorker.js",
    "worker:test": "node dist/workers/testWorker.js",
    "worker:agent": "node dist/workers/agentWorker.js",
    "worker:compile:dev": "tsx watch workers/compileWorker.ts",
    "worker:deploy:dev": "tsx watch workers/deployWorker.ts",
    "worker:test:dev": "tsx watch workers/testWorker.ts",
    "worker:agent:dev": "tsx watch workers/agentWorker.ts",
    "setup": "./setup.sh",
    "build": "prisma generate && tsc",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "generate-invites": "tsx scripts/generate-invites.ts",
    "backfill:file-paths": "tsx scripts/backfill-file-paths.ts",
    "seed:skills": "tsx scripts/seed-skills.ts",
    "dodo:products": "tsx scripts/create-dodo-products.ts",
    "worker:billing": "node dist/workers/billingWorker.js",
    "worker:billing:dev": "tsx watch workers/billingWorker.ts",
    "test": "node --import tsx --test tests/*.test.ts packages/websoroban-pay/*.test.ts",
    "build:pay-sdk": "npm --prefix packages/websoroban-pay run build",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "worker:payloop": "node dist/workers/payloopWorker.js",
    "worker:payloop:dev": "tsx watch workers/payloopWorker.ts",
    "payloop:deploy": "tsx scripts/payloop-deploy.ts",
    "payloop:reconcile": "tsx scripts/payloop-reconcile.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@stellar/stellar-base": "^13.1.0",
    "@stellar/stellar-sdk": "^14.6.1",
    "@x402/core": "^2.25.0",
    "@x402/express": "^2.25.0",
    "@x402/fetch": "^2.25.0",
    "@x402/stellar": "^2.25.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "bullmq": "^5.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "dodopayments": "^2.39.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.8",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.14.0",
    "prisma": "^6.19.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "standardwebhooks": "^1.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/body-parser": "^1.19.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.8",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.2",
    "@types/nodemailer": "^8.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pdfkit": "^0.17.6",
    "nodemon": "^3.0.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "soroban",
    "ide",
    "rust",
    "blockchain"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  }
}
