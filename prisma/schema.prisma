// WebSoroban backend data layer — Neon.tech (serverless Postgres) via Prisma.
//
// DATABASE_URL: pooled Neon connection string (?sslmode=require) used at runtime.
// DIRECT_URL:   direct (non-pooled) Neon connection string used for migrations.
//
// Run: npx prisma migrate dev --name init   (creates tables)
//      npx prisma generate                  (regenerates client)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// User
// `subscription` and `usage` are kept as JSON blobs to preserve the exact
// denormalized shape the API and frontend already consume. The relational
// Subscription/Payment tables below hold the full history.
// `walletAddress` is the user's EXTERNAL connect-wallet (auth) — distinct from
// the server-managed deploy Wallet relation below.
// ---------------------------------------------------------------------------
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  walletAddress      String?  @unique
  authMethod         String   @default("gmail")
  googleId           String?  @unique
  githubId           String?  @unique
  discordId          String?  @unique
  passwordHash       String?
  name               String   @default("")
  picture            String?
  subscription       Json     @default("{\"plan\":\"free\",\"status\":\"active\"}")
  usage              Json     @default("{}")
  isActive           Boolean  @default(true)
  lastLogin          DateTime @default(now())
  purchasedTemplates String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  wallet            Wallet?
  projects          Project[]
  jobs              Job[]
  deployments       Deployment[]
  subscriptions     Subscription[]
  payments          Payment[]
  usageLogs         UsageLog[]
  templatePurchases TemplatePurchase[]
  invocations       Invocation[]
  functionTests     FunctionTest[]
  userTemplates     UserTemplate[]
  chatThreads       ChatThread[]
  chatMessages      ChatMessage[]
  agentRuns         AgentRun[]
  plans             Plan[]
  aiSetting         AiSetting?
  keyExports        KeyExportAudit[]

  @@index([authMethod])
}

// ---------------------------------------------------------------------------
// Wallet — per-user Stellar testnet keypair, created on first login.
// Secret key is AES-256-GCM encrypted at rest; NEVER stored or returned plain.
// ---------------------------------------------------------------------------
model Wallet {
  id                 String   @id @default(cuid())
  userId             String   @unique
  publicKey          String
  secretKeyEncrypted String
  funded             Boolean  @default(false)
  // How mainnet transactions are signed for this user's generated wallet:
  //   "connected" — non-custodial (default): the browser wallet signs.
  //   "custodial" — explicit opt-in: the backend signs with the stored key.
  // Testnet always uses the custodial generated wallet.
  mainnetSigningMode String   @default("connected")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// KeyExportAudit — one row per gated private-key reveal/export. Never stores the
// key itself; just who exported it, when, and from where (for incident response).
// ---------------------------------------------------------------------------
model KeyExportAudit {
  id        String   @id @default(cuid())
  userId    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Project + File (embedded files array -> related File rows)
// ---------------------------------------------------------------------------
model Project {
  id              String    @id @default(cuid())
  name            String    @default("Untitled Project")
  userId          String
  // The contract address + spec below reflect the MOST RECENT deploy. The
  // network it was deployed to is recorded here; per-network history lives in
  // Deployment rows (a contract on testnet is distinct from one on mainnet).
  contractAddress String?
  network         String    @default("testnet")
  lastDeployed    DateTime?
  isLocal         Boolean   @default(false)
  // Multi-file build configuration.
  // `manifestPath` is the project-relative path of the Cargo manifest that
  // drives the build (almost always the root "Cargo.toml"; for a nested layout
  // it could be e.g. "contracts/token/Cargo.toml").
  manifestPath    String    @default("Cargo.toml")
  // For [workspace] manifests with multiple deployable members, the crate/
  // package name whose WASM gets deployed. Null for single-crate projects.
  deployTarget    String?
  // Parsed contract interface ({ entries, functions }) extracted from the
  // compiled WASM's `contractspecv0` section. Drives the type-aware invoke form.
  spec            Json?
  // SHA-256 of the last compiled/deployed WASM — used for deploy idempotency
  // and build caching.
  wasmHash        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  files       File[]
  deployments Deployment[]

  @@index([userId])
  @@index([userId, updatedAt])
}

model File {
  id        String   @id @default(cuid())
  projectId String
  // `path` is the project-relative POSIX path (e.g. "src/lib.rs",
  // "src/admin/mod.rs", "tests/integration.rs", ".cargo/config.toml"). The tree
  // is derived from path segments — there is no separate Folder table.
  // `name` is kept as the display/leaf name (last path segment) for backward
  // compatibility with the existing API contract.
  path      String
  name      String
  type      String   @default("file")
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Deployment — replaces Project.deploymentHistory embedded array.
// Records the deploying user's public key and the resulting contract id.
// ---------------------------------------------------------------------------
model Deployment {
  id                String   @id @default(cuid())
  projectId         String?
  userId            String?
  contractAddress   String?
  deployerPublicKey String?
  network           String   @default("testnet")
  status            String   @default("success")
  wasmHash          String?
  // For workspace projects: the crate/package name that was deployed. Null for
  // single-crate projects. Lets multiple deployable members be tracked per row.
  deployTarget      String?
  spec              Json?
  logs              String[] @default([])
  createdAt         DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
  @@index([contractAddress])
}

// ---------------------------------------------------------------------------
// Invocation — one record per contract function call (read simulate or write).
// returnValue is the decoded native result; secret keys are NEVER stored here.
// ---------------------------------------------------------------------------
model Invocation {
  id           String   @id @default(cuid())
  contractId   String
  userId       String?
  projectId    String?
  functionName String
  network      String   @default("testnet")
  args         Json     @default("{}")
  status       String   @default("pending") // simulated | submitted | success | failed
  readOnly     Boolean  @default(false)
  txHash       String?
  returnValue  Json?
  resourceFee  String?
  error        String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([contractId, createdAt])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// FunctionTest — a saved, named invocation case per function with an expected
// return assertion. "Run tests" executes each via the simulate path.
// ---------------------------------------------------------------------------
model FunctionTest {
  id           String   @id @default(cuid())
  contractId   String
  userId       String
  functionName String
  name         String
  args         Json     @default("{}")
  // { mode: 'success' | 'equals' | 'contains', value?: any }
  expected     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, contractId, functionName])
}

// ---------------------------------------------------------------------------
// Job — compile/deploy queue tracking (mirrors BullMQ jobs)
// ---------------------------------------------------------------------------
model Job {
  id        String   @id @default(cuid())
  type      String // compile | deploy
  status    String   @default("queued") // queued | active | completed | failed
  userId    String
  projectId String
  bullJobId String   @unique
  result    Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Invite
// ---------------------------------------------------------------------------
model Invite {
  id         String    @id @default(cuid())
  email      String
  inviteCode String    @unique
  sent       Boolean   @default(false)
  sentAt     DateTime?
  used       Boolean   @default(false)
  usedAt     DateTime?
  usedBy     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([email])
  @@index([email, sent])
  @@index([inviteCode, used])
}

// ---------------------------------------------------------------------------
// Subscription (history of subscription records)
// ---------------------------------------------------------------------------
model Subscription {
  id              String    @id @default(cuid())
  userId          String
  plan            String // free | plan2 | plan3
  status          String    @default("active") // active | cancelled | expired
  startDate       DateTime  @default(now())
  endDate         DateTime?
  paymentTxHash   String?
  paymentNetwork  String? // testnet | mainnet
  amount          Float     @default(0)
  currency        String    @default("XLM")
  autoRenew       Boolean   @default(false)
  cancelledAt     DateTime?
  cancelledReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId, status])
  @@index([paymentTxHash])
  @@index([endDate])
}

// ---------------------------------------------------------------------------
// Payment
// ---------------------------------------------------------------------------
model Payment {
  id             String    @id @default(cuid())
  userId         String
  subscriptionId String?
  plan           String // plan2 | plan3
  amount         Float
  currency       String    @default("XLM")
  txHash         String    @unique
  network        String // testnet | mainnet
  fromAddress    String
  toAddress      String
  status         String    @default("pending") // pending | confirmed | failed | refunded
  confirmedAt    DateTime?
  blockNumber    Int?
  memo           String?
  verified       Boolean   @default(false)
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// UsageLog
// ---------------------------------------------------------------------------
model UsageLog {
  id              String   @id @default(cuid())
  userId          String
  action          String // compile | deploy | function_test
  projectId       String?
  contractAddress String?
  functionName    String?
  success         Boolean  @default(true)
  error           String?
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, action, createdAt])
  @@index([contractAddress])
}

// ---------------------------------------------------------------------------
// UserTemplate — a contract the user assembled in the customisation wizard and
// saved for reuse. `config` is the wizard state (engine options + custom-function
// defs) so re-opening restores the controls; `bundle` is the resolved multi-file
// tree ({ files, manifestPath, deployTarget }) so it can scaffold without
// re-running the generator. `engine` is 'oz' (OpenZeppelin wizard) or 'internal'
// (WebSoroban composition engine); `type` is the contract kind (Fungible, NonFungible, counter, …).
// ---------------------------------------------------------------------------
model UserTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String
  engine    String
  config    Json     @default("{}")
  bundle    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, updatedAt])
}

// ---------------------------------------------------------------------------
// TemplatePurchase
// ---------------------------------------------------------------------------
model TemplatePurchase {
  id          String    @id @default(cuid())
  userId      String
  templateId  String
  amount      Float
  currency    String    @default("XLM")
  txHash      String?
  network     String    @default("testnet")
  status      String    @default("pending") // pending | confirmed | failed | expired
  memo        String    @unique
  confirmedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, templateId, status])
  @@index([status, createdAt])
}

// ===========================================================================
// AI COPILOT
// ---------------------------------------------------------------------------
// A thread is one Cursor-style conversation. Each thread is pinned to a `mode`
// (ask | agent | plan | debug | multitask) and a `model`; switching mode starts
// a fresh context window (enforced in the harness). Messages hold the streamed
// assistant text + collapsible reasoning; ToolCalls record every tool step
// (read_file, run_compile, propose_edit, …) and their produced diffs. AgentRuns
// are one execution of the tool loop — multitask spawns several child runs.
// ===========================================================================

// Per-user AI preferences (model + mode persistence) and an optional BYO
// OpenRouter key, encrypted at rest with WALLET_ENCRYPTION_KEY like wallet
// secrets — never stored or returned in plaintext.
model AiSetting {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  selectedModel          String   @default("openrouter/auto")
  mode                   String   @default("agent")
  maxMode                Boolean  @default(false)
  openRouterKeyEncrypted String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatThread {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  title     String   @default("New chat")
  mode      String   @default("agent") // ask | agent | plan | debug | multitask
  model     String   @default("openrouter/auto")
  maxMode   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  runs     AgentRun[]
  plans    Plan[]

  @@index([userId, updatedAt])
  @@index([projectId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  role      String // user | assistant | tool | system
  content   String   @default("")
  // Collapsible chain-of-thought (reasoning tokens), shown behind a disclosure.
  reasoning String?
  // Attached @-context chips, model, finishReason, token usage, runId, etc.
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolCalls ToolCall[]

  @@index([threadId, createdAt])
}

model ToolCall {
  id        String   @id @default(cuid())
  messageId String?
  runId     String?
  // OpenAI tool_call id, so streamed deltas reconcile to the right call.
  callId    String?
  name      String
  args      Json     @default("{}")
  result    Json?
  status    String   @default("pending") // pending | running | success | error
  // For propose_edit/create_file/delete_file: the unified diff for review.
  diff      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  run     AgentRun?    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([runId])
}

model AgentRun {
  id          String  @id @default(cuid())
  userId      String
  threadId    String?
  projectId   String?
  // Set on multitask sub-runs; null for a top-level run.
  parentRunId String?
  mode        String  @default("agent")
  model       String  @default("openrouter/auto")
  maxMode     Boolean @default(false)
  // queued | running | awaiting_confirm | completed | failed | cancelled
  status      String  @default("queued")
  prompt      String  @default("")
  title       String  @default("")
  bullJobId   String? @unique
  // Snapshot of the project file tree taken before the run — powers per-run undo.
  checkpoint  Json?
  // Proposed edits (path + unified diff + new content) awaiting diff review.
  diffs       Json    @default("[]")
  result      Json?
  error       String?
  tokensIn    Int     @default(0)
  tokensOut   Int     @default(0)
  iterations  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread    ChatThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  toolCalls ToolCall[]

  @@index([userId, createdAt])
  @@index([threadId])
  @@index([parentRunId])
  @@index([status, createdAt])
}

model Plan {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  threadId  String?
  title     String   @default("Implementation Plan")
  // Editable markdown (ordered steps, target file paths, TODO list, Mermaid).
  content   String   @default("")
  status    String   @default("draft") // draft | ready | building | done
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread ChatThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([projectId])
}
