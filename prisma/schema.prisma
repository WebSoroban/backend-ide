// WebSoroban backend data layer — Neon.tech (serverless Postgres) via Prisma.
//
// DATABASE_URL: pooled Neon connection string (?sslmode=require) used at runtime.
// DIRECT_URL:   direct (non-pooled) Neon connection string used for migrations.
//
// Run: npx prisma migrate dev --name init   (creates tables)
//      npx prisma generate                  (regenerates client)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// User
// `subscription` and `usage` are kept as JSON blobs to preserve the exact
// denormalized shape the API and frontend already consume. The relational
// Subscription/Payment tables below hold the full history.
// `walletAddress` is the user's EXTERNAL connect-wallet (auth) — distinct from
// the server-managed deploy Wallet relation below.
// ---------------------------------------------------------------------------
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  walletAddress      String?  @unique
  authMethod         String   @default("gmail")
  googleId           String?  @unique
  githubId           String?  @unique
  discordId          String?  @unique
  passwordHash       String?
  name               String   @default("")
  picture            String?
  subscription       Json     @default("{\"plan\":\"free\",\"status\":\"active\"}")
  usage              Json     @default("{}")
  // AI Copilot credits (fiat, via Dodo). Denormalized running balance kept in
  // lock-step with CreditLedger inside the same transaction; the ledger is the
  // source of truth. Distinct from the testnet-XLM plan/template payment flow.
  credits            Int      @default(0)
  // Dodo Payments customer id (fiat billing), created/reused at first checkout.
  dodoCustomerId     String?
  isActive           Boolean  @default(true)
  lastLogin          DateTime @default(now())
  purchasedTemplates String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  wallet            Wallet?
  projects          Project[]
  jobs              Job[]
  deployments       Deployment[]
  subscriptions     Subscription[]
  payments          Payment[]
  usageLogs         UsageLog[]
  templatePurchases TemplatePurchase[]
  invocations       Invocation[]
  functionTests     FunctionTest[]
  userTemplates     UserTemplate[]
  chatThreads       ChatThread[]
  chatMessages      ChatMessage[]
  agentRuns         AgentRun[]
  plans             Plan[]
  aiSetting         AiSetting?
  keyExports        KeyExportAudit[]
  skills            Skill[]
  skillPreferences  SkillPreference[]
  creditLedger      CreditLedger[]
  aiUsage           AiUsage[]
  x402Endpoints     X402Endpoint[]
  x402Webhooks      X402Webhook[]
  x402AgentWallets  X402AgentWallet[]

  @@index([authMethod])
}

// ---------------------------------------------------------------------------
// Wallet — per-user Stellar testnet keypair, created on first login.
// Secret key is AES-256-GCM encrypted at rest; NEVER stored or returned plain.
// ---------------------------------------------------------------------------
model Wallet {
  id                 String   @id @default(cuid())
  userId             String   @unique
  publicKey          String
  secretKeyEncrypted String
  funded             Boolean  @default(false)
  // How mainnet transactions are signed for this user's generated wallet:
  //   "connected" — non-custodial (default): the browser wallet signs.
  //   "custodial" — explicit opt-in: the backend signs with the stored key.
  // Testnet always uses the custodial generated wallet.
  mainnetSigningMode String   @default("connected")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// KeyExportAudit — one row per gated private-key reveal/export. Never stores the
// key itself; just who exported it, when, and from where (for incident response).
// ---------------------------------------------------------------------------
model KeyExportAudit {
  id        String   @id @default(cuid())
  userId    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Project + File (embedded files array -> related File rows)
// ---------------------------------------------------------------------------
model Project {
  id              String    @id @default(cuid())
  name            String    @default("Untitled Project")
  userId          String
  // The contract address + spec below reflect the MOST RECENT deploy. The
  // network it was deployed to is recorded here; per-network history lives in
  // Deployment rows (a contract on testnet is distinct from one on mainnet).
  contractAddress String?
  network         String    @default("testnet")
  lastDeployed    DateTime?
  isLocal         Boolean   @default(false)
  // Multi-file build configuration.
  // `manifestPath` is the project-relative path of the Cargo manifest that
  // drives the build (almost always the root "Cargo.toml"; for a nested layout
  // it could be e.g. "contracts/token/Cargo.toml").
  manifestPath    String    @default("Cargo.toml")
  // For [workspace] manifests with multiple deployable members, the crate/
  // package name whose WASM gets deployed. Null for single-crate projects.
  deployTarget    String?
  // Parsed contract interface ({ entries, functions }) extracted from the
  // compiled WASM's `contractspecv0` section. Drives the type-aware invoke form.
  spec            Json?
  // SHA-256 of the last compiled/deployed WASM — used for deploy idempotency
  // and build caching.
  wasmHash        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  files         File[]
  deployments   Deployment[]
  x402Endpoints X402Endpoint[]

  @@index([userId])
  @@index([userId, updatedAt])
}

model File {
  id        String   @id @default(cuid())
  projectId String
  // `path` is the project-relative POSIX path (e.g. "src/lib.rs",
  // "src/admin/mod.rs", "tests/integration.rs", ".cargo/config.toml"). The tree
  // is derived from path segments — there is no separate Folder table.
  // `name` is kept as the display/leaf name (last path segment) for backward
  // compatibility with the existing API contract.
  path      String
  name      String
  type      String   @default("file")
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Deployment — replaces Project.deploymentHistory embedded array.
// Records the deploying user's public key and the resulting contract id.
// ---------------------------------------------------------------------------
model Deployment {
  id                String   @id @default(cuid())
  projectId         String?
  userId            String?
  contractAddress   String?
  deployerPublicKey String?
  network           String   @default("testnet")
  status            String   @default("success")
  wasmHash          String?
  // For workspace projects: the crate/package name that was deployed. Null for
  // single-crate projects. Lets multiple deployable members be tracked per row.
  deployTarget      String?
  spec              Json?
  logs              String[] @default([])
  createdAt         DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
  @@index([contractAddress])
}

// ---------------------------------------------------------------------------
// Invocation — one record per contract function call (read simulate or write).
// returnValue is the decoded native result; secret keys are NEVER stored here.
// ---------------------------------------------------------------------------
model Invocation {
  id           String   @id @default(cuid())
  contractId   String
  userId       String?
  projectId    String?
  functionName String
  network      String   @default("testnet")
  args         Json     @default("{}")
  status       String   @default("pending") // simulated | submitted | success | failed
  readOnly     Boolean  @default(false)
  txHash       String?
  returnValue  Json?
  resourceFee  String?
  error        String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([contractId, createdAt])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// FunctionTest — a saved, named invocation case per function with an expected
// return assertion. "Run tests" executes each via the simulate path.
// ---------------------------------------------------------------------------
model FunctionTest {
  id           String   @id @default(cuid())
  contractId   String
  userId       String
  functionName String
  name         String
  args         Json     @default("{}")
  // { mode: 'success' | 'equals' | 'contains', value?: any }
  expected     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, contractId, functionName])
}

// ---------------------------------------------------------------------------
// Job — compile/deploy queue tracking (mirrors BullMQ jobs)
// ---------------------------------------------------------------------------
model Job {
  id        String   @id @default(cuid())
  type      String // compile | deploy
  status    String   @default("queued") // queued | active | completed | failed
  userId    String
  projectId String
  bullJobId String   @unique
  result    Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Invite
// ---------------------------------------------------------------------------
model Invite {
  id         String    @id @default(cuid())
  email      String
  inviteCode String    @unique
  sent       Boolean   @default(false)
  sentAt     DateTime?
  used       Boolean   @default(false)
  usedAt     DateTime?
  usedBy     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([email])
  @@index([email, sent])
  @@index([inviteCode, used])
}

// ---------------------------------------------------------------------------
// Subscription (history of subscription records)
// ---------------------------------------------------------------------------
model Subscription {
  id              String    @id @default(cuid())
  userId          String
  plan            String // free | plan2 | plan3
  status          String    @default("active") // active | cancelled | expired
  startDate       DateTime  @default(now())
  endDate         DateTime?
  paymentTxHash   String?
  paymentNetwork  String? // testnet | mainnet
  amount          Float     @default(0)
  currency        String    @default("XLM")
  autoRenew       Boolean   @default(false)
  cancelledAt     DateTime?
  cancelledReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId, status])
  @@index([paymentTxHash])
  @@index([endDate])
}

// ---------------------------------------------------------------------------
// Payment
// ---------------------------------------------------------------------------
model Payment {
  id             String    @id @default(cuid())
  userId         String
  subscriptionId String?
  plan           String // plan2 | plan3
  amount         Float
  currency       String    @default("XLM")
  txHash         String    @unique
  network        String // testnet | mainnet
  fromAddress    String
  toAddress      String
  status         String    @default("pending") // pending | confirmed | failed | refunded
  confirmedAt    DateTime?
  blockNumber    Int?
  memo           String?
  verified       Boolean   @default(false)
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// WebSoroban Pay — hosted x402 endpoints and their append-only request trail.
// API keys are stored as SHA-256 digests; the plaintext key is returned once.
// Settles USDC on stellar:testnet, and on stellar:pubnet when the operator
// configures a mainnet facilitator.
// ---------------------------------------------------------------------------
model X402Endpoint {
  id           String   @id @default(cuid())
  userId       String
  projectId    String?
  name         String
  slug         String   @unique
  method       String   @default("GET")
  price        String
  asset        String   @default("USDC")
  network      String   @default("stellar:testnet")
  payTo        String
  responseBody Json     @default("{\"message\":\"Paid access granted.\"}")
  apiKeyHash   String   @unique
  apiKeyPrefix String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  events       X402Event[]
  webhooks     X402Webhook[]
  agentWallets X402AgentWallet[]

  @@index([userId, updatedAt])
  @@index([projectId])
  @@index([active])
}

model X402Event {
  id                 String   @id @default(cuid())
  endpointId         String
  type               String
  status             String
  requestFingerprint String?
  transaction        String?
  payer              String?
  amount             String?
  errorCode          String?
  errorMessage       String?
  latencyMs          Int?
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now())

  endpoint X402Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([endpointId, status, createdAt])
  @@index([transaction])
}

// Developer-registered callbacks for settled and failed payments.
// The signing secret is encrypted at rest and returned once at creation.
model X402Webhook {
  id              String   @id @default(cuid())
  userId          String
  endpointId      String?
  url             String
  events          String[]
  secretEncrypted String
  secretPrefix    String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   X402Endpoint?          @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  deliveries X402WebhookDelivery[]

  @@index([userId, createdAt])
  @@index([endpointId])
}

model X402WebhookDelivery {
  id             String    @id @default(cuid())
  webhookId      String
  eventType      String
  payload        Json
  status         String
  attempts       Int       @default(0)
  nextAttemptAt  DateTime?
  lastStatusCode Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  webhook X402Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@index([status, nextAttemptAt])
}

// Agent signer registered with an OpenZeppelin-shaped daily USDC spending limit.
// The settle path rejects a payment that would exceed the cap before the
// facilitator is called.
model X402AgentWallet {
  id              String   @id @default(cuid())
  userId          String
  endpointId      String?
  name            String
  publicKey       String
  spendLimitUsdc  String
  limitStroops    String
  spentStroops    String   @default("0")
  periodSeconds   Int      @default(86400)
  periodLedgers   Int      @default(17280)
  windowStartedAt DateTime @default(now())
  asset           String   @default("USDC")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint     X402Endpoint?           @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  reservations X402SpendReservation[]

  @@index([userId, createdAt])
  @@index([publicKey])
  @@index([endpointId])
}

// Spend held against an agent wallet while one payment settles. Keyed by the
// payment fingerprint so a retried settle is idempotent and the outcome can be
// committed or released by any API instance.
model X402SpendReservation {
  id              String   @id @default(cuid())
  walletId        String
  fingerprint     String   @unique
  amountStroops   String
  windowStartedAt DateTime
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  wallet X402AgentWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, status])
}

// ---------------------------------------------------------------------------
// UsageLog
// ---------------------------------------------------------------------------
model UsageLog {
  id              String   @id @default(cuid())
  userId          String
  action          String // compile | deploy | function_test
  projectId       String?
  contractAddress String?
  functionName    String?
  success         Boolean  @default(true)
  error           String?
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, action, createdAt])
  @@index([contractAddress])
}

// ---------------------------------------------------------------------------
// UserTemplate — a contract the user assembled in the customisation wizard and
// saved for reuse. `config` is the wizard state (engine options + custom-function
// defs) so re-opening restores the controls; `bundle` is the resolved multi-file
// tree ({ files, manifestPath, deployTarget }) so it can scaffold without
// re-running the generator. `engine` is 'oz' (OpenZeppelin wizard) or 'internal'
// (WebSoroban composition engine); `type` is the contract kind (Fungible, NonFungible, counter, …).
// ---------------------------------------------------------------------------
model UserTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String
  engine    String
  config    Json     @default("{}")
  bundle    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, updatedAt])
}

// ---------------------------------------------------------------------------
// TemplatePurchase
// ---------------------------------------------------------------------------
model TemplatePurchase {
  id          String    @id @default(cuid())
  userId      String
  templateId  String
  amount      Float
  currency    String    @default("XLM")
  txHash      String?
  network     String    @default("testnet")
  status      String    @default("pending") // pending | confirmed | failed | expired
  memo        String    @unique
  confirmedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, templateId, status])
  @@index([status, createdAt])
}

// ===========================================================================
// AI COPILOT
// ---------------------------------------------------------------------------
// A thread is one Cursor-style conversation. Each thread is pinned to a `mode`
// (ask | agent | plan | debug | multitask) and a `model`; switching mode starts
// a fresh context window (enforced in the harness). Messages hold the streamed
// assistant text + collapsible reasoning; ToolCalls record every tool step
// (read_file, run_compile, propose_edit, …) and their produced diffs. AgentRuns
// are one execution of the tool loop — multitask spawns several child runs.
// ===========================================================================

// Per-user AI preferences (model + mode persistence) and an optional BYO
// OpenRouter key, encrypted at rest with WALLET_ENCRYPTION_KEY like wallet
// secrets — never stored or returned in plaintext.
model AiSetting {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  selectedModel          String   @default("openrouter/auto")
  mode                   String   @default("agent")
  maxMode                Boolean  @default(false)
  openRouterKeyEncrypted String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatThread {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  title     String   @default("New chat")
  mode      String   @default("agent") // ask | agent | plan | debug | multitask
  model     String   @default("openrouter/auto")
  maxMode   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  runs     AgentRun[]
  plans    Plan[]

  @@index([userId, updatedAt])
  @@index([projectId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  role      String // user | assistant | tool | system
  content   String   @default("")
  // Collapsible chain-of-thought (reasoning tokens), shown behind a disclosure.
  reasoning String?
  // Attached @-context chips, model, finishReason, token usage, runId, etc.
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolCalls ToolCall[]

  @@index([threadId, createdAt])
}

model ToolCall {
  id        String   @id @default(cuid())
  messageId String?
  runId     String?
  // OpenAI tool_call id, so streamed deltas reconcile to the right call.
  callId    String?
  name      String
  args      Json     @default("{}")
  result    Json?
  status    String   @default("pending") // pending | running | success | error
  // For propose_edit/create_file/delete_file: the unified diff for review.
  diff      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  run     AgentRun?    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([runId])
}

model AgentRun {
  id          String  @id @default(cuid())
  userId      String
  threadId    String?
  projectId   String?
  // Set on multitask sub-runs; null for a top-level run.
  parentRunId String?
  mode        String  @default("agent")
  model       String  @default("openrouter/auto")
  maxMode     Boolean @default(false)
  // queued | running | awaiting_confirm | completed | failed | cancelled
  status      String  @default("queued")
  prompt      String  @default("")
  title       String  @default("")
  bullJobId   String? @unique
  // Snapshot of the project file tree taken before the run — powers per-run undo.
  checkpoint  Json?
  // Proposed edits (path + unified diff + new content) awaiting diff review.
  diffs       Json    @default("[]")
  result      Json?
  error       String?
  tokensIn    Int     @default(0)
  tokensOut   Int     @default(0)
  iterations  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread    ChatThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  toolCalls ToolCall[]

  @@index([userId, createdAt])
  @@index([threadId])
  @@index([parentRunId])
  @@index([status, createdAt])
}

model Plan {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  threadId  String?
  title     String   @default("Implementation Plan")
  // Editable markdown (ordered steps, target file paths, TODO list, Mermaid).
  content   String   @default("")
  status    String   @default("draft") // draft | ready | building | done
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread ChatThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Skill — a user-authored (or OFFICIAL, ownerId null) Soroban/Stellar knowledge
// + instruction pack the Copilot loads as CONTEXT (Cursor/Claude-style "skills"),
// scoped to Soroban. Progressive disclosure keeps it token-efficient:
//   - the INDEX (name + description + whenToUse) is injected every run (cheap);
//   - the BODY is pulled on demand via the load_skill tool, injected every run
//     for scope="always", and force-loaded when the user @skill:<slug>-mentions it.
// Skill bodies are GUIDANCE/DATA, never authority: they can shape HOW contracts
// are written but cannot widen the Soroban-only scope, the file-type allowlist,
// or the secret/deploy/safety rules (enforced in the harness guardrail layer and
// validated on save). `slug` is the @skill/load_skill handle (unique per owner).
// Per-user enable/disable of official/public skills lives in SkillPreference.
// ---------------------------------------------------------------------------
model Skill {
  id          String   @id @default(cuid())
  ownerId     String? // null => OFFICIAL (seeded, global)
  official    Boolean  @default(false)
  name        String
  slug        String
  description String   @default("")
  whenToUse   String   @default("")
  body        String   @default("")
  scope       String   @default("auto") // always | auto | manual
  enabled     Boolean  @default(true)
  visibility  String   @default("private") // private | public
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User?             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  preferences SkillPreference[]

  @@unique([ownerId, slug])
  @@index([ownerId, enabled])
  @@index([official, enabled])
  @@index([visibility])
}

// ---------------------------------------------------------------------------
// SkillPreference — a per-user enable/disable override for a skill the user does
// not own (an OFFICIAL skill, or a PUBLIC skill from another user). Owners toggle
// their own skills via Skill.enabled directly; this table records the toggle for
// everyone else, so official skills can be turned off per-user without mutating
// the shared row.
// ---------------------------------------------------------------------------
model SkillPreference {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
}

// ===========================================================================
// AI CREDITS / FIAT BILLING (Dodo Payments)
// ---------------------------------------------------------------------------
// One-time credit packs bought with real money via Dodo (LIVE mode). The
// CreditLedger is the SOURCE OF TRUTH for a user's balance; User.credits is a
// denormalized running total updated in the SAME transaction as each ledger row.
// This is entirely separate from the testnet-XLM plan/template payment flow
// (Payment/Subscription models above) — do not conflate them.
// ===========================================================================

// Append-only ledger of every credit movement. Balance is derivable by summing
// `delta`; `balanceAfter` snapshots the running total at write time.
// Idempotency: @@unique([userId, reason, refId]) means a signup grant, a purchase
// (refId = Dodo payment id), and a usage debit (refId = AgentRun id) can each be
// applied at most once — a retried webhook or worker job can't double-credit/charge.
model CreditLedger {
  id           String   @id @default(cuid())
  userId       String
  // + for grants (signup/purchase/refund/admin), - for usage spend.
  delta        Int
  // signup_grant | purchase | usage | refund | admin
  reason       String
  // paymentId (purchase) | aiRunId (usage) | "signup" (signup_grant) | null.
  refId        String?
  // The user's credit balance immediately after this entry was applied.
  balanceAfter Int
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, refId])
  @@index([userId, createdAt])
}

// Per-run AI usage record: actual model cost (from OpenRouter) and the credits
// charged for it. `runId` is unique so a retried worker can't write twice.
model AiUsage {
  id             String   @id @default(cuid())
  userId         String
  runId          String   @unique
  model          String
  mode           String
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  // Actual USD cost reported by OpenRouter for all model calls in the run.
  costUsd        Float    @default(0)
  // Credits debited for this run (costUsd → credits via the configured rate).
  creditsCharged Int      @default(0)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Dedupe table for incoming Dodo webhook events (Standard Webhooks `webhook-id`).
// The credit grant is also idempotent via the ledger unique constraint; this
// gives a fast "already handled" ack and an audit trail of what we received.
model ProcessedWebhookEvent {
  id        String   @id @default(cuid())
  // The Standard Webhooks `webhook-id` header (provider event id).
  eventId   String   @unique
  source    String   @default("dodo")
  type      String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

// ---------------------------------------------------------------------------
// PayLoop — non-custodial USDC subscriptions. The Soroban contract is the
// source of truth; these tables are an index of it, rebuilt from contract
// events and checked by the reconciliation job.
// ---------------------------------------------------------------------------
model PayLoopPolicy {
  id               String    @id @default(cuid())
  network          String
  contractId       String
  policyId         BigInt
  subscriber       String
  merchant         String
  /// Token amounts are i128 stroop strings.
  amount           String
  intervalSeconds  Int
  cap              String
  spent            String
  charges          Int
  failedAttempts   Int
  nextChargeAt     DateTime
  chainCreatedAt   DateTime
  status           String
  /// Relayer bookkeeping: when it last tried this policy and why it failed.
  lastAttemptAt    DateTime?
  lastAttemptError String?
  syncedLedger     Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  chargeLog PayLoopCharge[]

  @@unique([contractId, policyId])
  @@index([contractId, status, nextChargeAt])
  @@index([subscriber])
  @@index([merchant])
}

model PayLoopCharge {
  id             String   @id @default(cuid())
  contractId     String
  policyId       BigInt
  /// RPC event id; makes indexing idempotent.
  eventId        String   @unique
  txHash         String
  ledger         Int
  ledgerClosedAt DateTime
  /// charged | insufficient_balance | insufficient_allowance
  outcome        String
  amount         String
  chargeNumber   Int?
  dueAt          DateTime
  delaySeconds   Int
  createdAt      DateTime @default(now())

  policy PayLoopPolicy @relation(fields: [contractId, policyId], references: [contractId, policyId], onDelete: Cascade)

  @@index([contractId, policyId, ledger])
  @@index([contractId, outcome, ledgerClosedAt])
}

/// Indexer cursor and the single-worker lease for one deployed contract.
model PayLoopSyncState {
  contractId String    @id
  network    String
  cursor     String?
  lastLedger Int       @default(0)
  leaseOwner String?
  leaseUntil DateTime?
  updatedAt  DateTime  @updatedAt
}

/// A community idea for the Idea Bank. Anyone can submit; it stays private
/// until an admin accepts it, and only accepted rows are shown publicly.
model IdeaSubmission {
  id          String    @id @default(cuid())
  title       String
  goal        String
  description String
  alignment   String    @default("")
  author      String
  /// Email or Discord handle so the team can follow up. Never returned publicly.
  contact     String    @default("")
  link        String?
  /// pending | accepted | rejected
  status      String    @default("pending")
  reviewNote  String    @default("")
  userId      String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
}
