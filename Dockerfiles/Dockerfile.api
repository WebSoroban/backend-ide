# Node 20+ is required by @stellar/stellar-sdk@14 (and stellar-base@14).
FROM node:20-alpine

# Install system dependencies
RUN apk add --no-cache \
    docker \
    curl \
    bash

# Create app directory
WORKDIR /app

# Copy package files
COPY package*.json ./
# Prisma schema is required by the postinstall `prisma generate`
COPY prisma ./prisma

# Install dependencies, including devDependencies (typescript) needed to build.
# --ignore-scripts: skip package postinstall scripts. This avoids esbuild's
# install.js exec-on-write step, which intermittently fails under BuildKit with
# `ETXTBSY` (esbuild/tsx are dev-only and unused in the compiled image). Prisma
# Client is generated by `npm run build` below, so skipping postinstall is safe.
# Using npm install instead of npm ci to handle lockfile sync issues.
RUN npm install --legacy-peer-deps --ignore-scripts

# Copy app source (node_modules excluded via .dockerignore)
COPY . .

# Compile TypeScript -> dist/ (build script = `prisma generate && tsc`)
RUN npm run build

# Create necessary directories
RUN mkdir -p /app/temp /app/logs

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3001/api/health || exit 1

# Start the API server (compiled output)
CMD ["node", "dist/server.js"]

