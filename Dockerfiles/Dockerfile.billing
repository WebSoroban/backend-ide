# Billing (credit-grant) worker — LIGHTWEIGHT.
#
# Unlike the compile/deploy/test/agent workers, this one never runs Rust or the
# Stellar CLI; it only processes verified Dodo webhook events (DB + Redis + the
# Dodo API). So it uses the same lean node:20-alpine base as the API instead of
# the heavy rust:1.89 toolchain image — far faster to build and much smaller.
#
# Point the worker-billing service at railway.worker-billing.toml.
FROM node:20-alpine

# bash for convenience; no docker CLI / no Rust toolchain needed here.
RUN apk add --no-cache curl bash

WORKDIR /app

# Copy package files; prisma schema is needed by `prisma generate` in build.
COPY package*.json ./
COPY prisma ./prisma

# Install deps (incl. devDeps for the tsc build). --ignore-scripts skips esbuild's
# postinstall (ETXTBSY under BuildKit); Prisma Client is generated by the build.
RUN npm install --legacy-peer-deps --ignore-scripts

# Copy source (node_modules excluded via .dockerignore) and compile -> dist/.
COPY . .
RUN npm run build

RUN mkdir -p /app/logs

# No EXPOSE / HEALTHCHECK: a worker runs no HTTP server. Railway gates this
# service via railway.worker-billing.toml (no healthcheckPath) + restart policy.
CMD ["node", "dist/workers/billingWorker.js"]
